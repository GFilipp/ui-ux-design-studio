# run artifacts
design-run.json
*.run.json
*.extract.json
floor.*.json
samples/*.png
samples/*.jpeg

# reference captures: third-party site screenshots stay local (copyright + size); only INDEX.md is committed
exemplars/captures/

# real / proprietary brand kits — the engine ships only the example profile
brand-kits/*
!brand-kits/SCHEMA.md
!brand-kits/example-*/
!brand-kits/example-*/**

# node / os / secrets / local config
node_modules/
.DS_Store
.env
*.key
*.pem
.claude.json
.claude/settings.local.json

# python bytecode (build noise, never versioned)
__pycache__/
*.pyc
